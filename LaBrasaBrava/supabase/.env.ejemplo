# Copiá este archivo como .env (en la raíz del proyecto) y completá los valores.
# Los encontrás en Supabase → Project Settings → Data API.

SUPABASE_URL=https://TU-PROYECTO.supabase.co

# ATENCIÓN: la clave service_role es SECRETA. Nunca se sube al repositorio
# ni se escribe en el código de la aplicación. Solo la usa supabase/seed.mjs.
SUPABASE_SERVICE_ROLE_KEY=TU_CLAVE_SERVICE_ROLE
